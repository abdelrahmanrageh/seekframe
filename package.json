{
  "name": "seekframe",
  "version": "0.2.0",
  "description": "Brand films as code. Your LLM writes the film, you edit it in the browser, it renders to MP4.",
  "keywords": [
    "video",
    "motion-graphics",
    "llm",
    "ai-agents",
    "mcp",
    "animation",
    "ffmpeg",
    "playwright",
    "rtl"
  ],
  "license": "MIT",
  "author": "Abdelrahman Rageh",
  "homepage": "https://github.com/abdelrahmanrageh/seekframe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdelrahmanrageh/seekframe.git"
  },
  "bugs": "https://github.com/abdelrahmanrageh/seekframe/issues",
  "bin": {
    "seekframe": "bin/seekframe.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "dist",
    "assets",
    "templates",
    "docs",
    "llm",
    "examples",
    "AGENTS.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "!examples/*/brand/fonts/**",
    "!**/brand/brand.css",
    "!**/brand/brand.js",
    "!examples/*/preview/**",
    "!**/uploads/**",
    "!**/.DS_Store"
  ],
  "scripts": {
    "editor": "node bin/seekframe.js editor",
    "validate": "node bin/seekframe.js validate",
    "test": "node --test 'dist-test/*.test.js'",
    "test:unit": "node scripts/build.mjs && node scripts/build-tests.mjs && node --test dist-test/unit.test.js",
    "mcp-path": "node -e \"console.log(require('path').resolve('bin/seekframe.js'))\"",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.browser.json",
    "prepare": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs && node scripts/build-tests.mjs",
    "site": "node scripts/build-site.mjs --serve"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ajv": "^8.17.1",
    "ffmpeg-static": "^5.3.0",
    "imagetracerjs": "^1.2.6",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "main": "dist/cli.js",
  "allowScripts": {
    "esbuild": true,
    "ffmpeg-static": true
  }
}
