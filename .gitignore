node_modules/
output/
.DS_Store
*.log
# editor scratch
films/*/uploads/
examples/*/uploads/
# non-redistributable assets are appended here by `seekframe brand add-font --no-redistribute`
# non-redistributable font (Thmanyah Sans): get it from https://ask.thmanyah.com/hc/en-001/articles/45993930027281-Thmanyah-Font-for-Everyone

# generated from brand.json by `seekframe brand build` (rebuilt automatically; depends on which fonts exist locally)
**/brand/brand.css
**/brand/brand.js
dist/
dist-test/
dist-site/

# editor version history (local snapshots) and stray renders
**/projects/.history/
/*.wav
/*.mp4

# sound packs are third-party audio: keep them local (templates/glow/assets/sfx/README.md)
templates/*/assets/sfx/*.mp3
templates/*/assets/sfx/*.wav
examples/*/assets/sfx/*.mp3
examples/*/assets/sfx/*.wav

# your own films stay local: client or private work must never be committed to this public repo (see AGENTS.md)
films/*
!films/.gitkeep
