{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/abdelrahmanrageh/seekframe/schema/film-manifest",
  "title": "Film manifest (window.manifest of a film page)",
  "type": "object",
  "required": [
    "schema",
    "title",
    "width",
    "height",
    "fps",
    "duration",
    "scenes"
  ],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "width": {
      "type": "integer",
      "minimum": 16,
      "maximum": 8192
    },
    "height": {
      "type": "integer",
      "minimum": 16,
      "maximum": 8192
    },
    "fps": {
      "type": "number",
      "minimum": 1,
      "maximum": 120
    },
    "duration": {
      "type": "integer",
      "minimum": 1,
      "description": "Total length in frames at `fps`."
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "start",
          "end"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1,
            "description": "Exclusive."
          },
          "allow": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Craft-check opt-outs, each 'check: reason'. Each one costs score points."
          }
        }
      }
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "default"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "type": {
            "enum": [
              "text",
              "number",
              "color",
              "boolean",
              "select",
              "image"
            ]
          },
          "label": {
            "type": "string"
          },
          "help": {
            "type": "string"
          },
          "scene": {
            "type": "string",
            "description": "Scene id this option belongs to. Omit for film-wide options (Style tab)."
          },
          "cssVar": {
            "type": "string",
            "pattern": "^--[A-Za-z0-9_-]+$",
            "description": "Editor sets this CSS custom property on <html> to the value (numbers get `unit` appended)."
          },
          "group": {
            "type": "string",
            "enum": [
              "sound"
            ],
            "description": "'sound': show this option in the editor's Audio tab (e.g. the sound theme) instead of Style."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "text"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "string"
                },
                "multiline": {
                  "type": "boolean"
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "number"
                }
              }
            },
            "then": {
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "default": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "color"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "boolean"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "select"
                }
              }
            },
            "then": {
              "required": [
                "options"
              ],
              "properties": {
                "default": {
                  "type": "string"
                },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "required": [
                          "value"
                        ],
                        "properties": {
                          "value": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "image"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "string",
                  "description": "Path relative to the film folder, or empty."
                }
              }
            }
          }
        ]
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string"
          },
          "src": {
            "type": "string",
            "description": "Path relative to the film folder. wav/mp3/m4a/ogg. Omit when `generated` is set."
          },
          "sync": {
            "enum": [
              "timeline",
              "free"
            ],
            "default": "timeline"
          },
          "group": {
            "type": "string",
            "description": "Tracks sharing a group are mutually exclusive in the editor."
          },
          "default": {
            "type": "boolean"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5
          },
          "generated": {
            "enum": [
              "cues"
            ],
            "description": "The track is rendered from manifest.cues by the Seekframe sound engine (see docs/SOUND.md)."
          }
        }
      }
    },
    "sizes": {
      "type": "array",
      "description": "Extra output sizes the film can lay itself out for (reads window.innerWidth/innerHeight). Omit if the film is fixed-size.",
      "items": {
        "type": "object",
        "required": [
          "width",
          "height"
        ],
        "properties": {
          "width": {
            "type": "integer"
          },
          "height": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "cues": {
      "type": "array",
      "description": "Sound events on the source timeline (frames at `fps`). Rendered by the sound engine.",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "f"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "f": {
            "type": "number",
            "minimum": 0
          },
          "to": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "soundtrack": {
      "type": "object",
      "properties": {
        "theme": {
          "type": "string",
          "description": "deep | bright | minimal"
        },
        "loudness": {
          "type": "number",
          "description": "Target LUFS, default -16."
        }
      }
    },
    "lang": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "rtl": {
          "type": "boolean"
        }
      }
    },
    "variants": {
      "type": "object",
      "description": "Named combinations of params for the editor's Variants view and `seekframe matrix`.",
      "properties": {
        "axes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "presets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "params": {
                "type": "object"
              }
            }
          }
        },
        "thumbFrame": {
          "type": "number",
          "description": "Frame (edited timeline) used for variant thumbnails. Default: the middle of the film."
        }
      }
    },
    "poster": {
      "type": "number",
      "minimum": 0,
      "description": "Source frame the editor opens on and thumbnails use."
    }
  }
}
